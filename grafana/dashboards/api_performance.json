  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Overall API Availability (SLA %)",
      "type": "gauge",
      "targets": [
        { "expr": "avg(api_sla_uptime_percent)", "legendFormat": "Average SLA" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Active Operational Endpoints",
      "type": "stat",
      "targets": [
        { "expr": "sum(api_uptime_status)", "legendFormat": "Online Endpoints" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "id": 3,
      "title": "Current Response Latencies (ms)",
      "type": "barplot",
      "targets": [
        { "expr": "api_response_time_ms", "legendFormat": "{{endpoint}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 6 },
      "id": 4,
      "title": "API Response Latency Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "api_response_time_ms", "legendFormat": "{{endpoint}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "lineInterpolation": "smooth" } } }
    }
  ],
